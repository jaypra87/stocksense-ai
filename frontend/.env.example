# Copy to .env.local for local dev. Anything prefixed with NEXT_PUBLIC_ is exposed to the browser.

# Where the API proxy (app/api/v1/[...path]) forwards requests. Server-side only.
BACKEND_URL=http://localhost:8000

# Shared secret the proxy attaches so the backend can trust the client IP it
# reports. Must equal PROXY_SHARED_SECRET on the backend. Optional locally.
API_PROXY_SECRET=

# Set to "true" on the public demo deployment to show the live-demo banner.
NEXT_PUBLIC_DEMO_MODE=

# Cloudflare Turnstile site key (public). Leave empty to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical site URL (used for SEO metadata, sitemap, robots). Set on the deployed frontend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
