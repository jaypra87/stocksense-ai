# Copy to .env.local for local dev. Anything prefixed with NEXT_PUBLIC_ is exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to "true" on the public demo deployment to show the synthetic-data banner.
NEXT_PUBLIC_DEMO_MODE=

# Canonical site URL (used for SEO metadata, sitemap, robots). Set on the deployed frontend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
