# Copy this to .env and fill in real values. Never commit .env.
# These are read by docker-compose. Per-service envs live in backend/.env and frontend/.env.local.

# --- Postgres ---
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense

# --- Redis ---
# No password in dev. In prod, set REDIS_PASSWORD and update REDIS_URL.

# --- Backend ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
