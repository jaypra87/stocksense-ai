ENVIRONMENT=development

# DB and cache (in docker compose these are set automatically; for bare-metal dev, override)
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense
REDIS_URL=redis://localhost:6379/0

# CORS — origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# JWT (filled in Phase 8 when auth lands; placeholder for now)
# Generate with: openssl rand -hex 32 (min 32 chars; enforced in production)
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Market data providers (filled in Phase 2)
MARKET_DATA_PROVIDER=yfinance
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
