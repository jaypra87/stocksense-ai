ENVIRONMENT=development

# DB and cache (in docker compose these are set automatically; for bare-metal dev, override)
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense
REDIS_URL=redis://localhost:6379/0

# CORS — origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Session signing. Generate with: openssl rand -hex 32 (min 32 chars; enforced in production)
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
# Sessions (and the cookie) live this long; guests keep their data for this window.
SESSION_TTL_DAYS=30

# Emails are stored AES-GCM encrypted. 64 hex chars: openssl rand -hex 32
# Required in production. Unset in development = a fixed, public dev key.
EMAIL_ENCRYPTION_KEY=

# Must match API_PROXY_SECRET on the frontend. Optional in development.
PROXY_SHARED_SECRET=

# Cloudflare Turnstile secret key. Unset = bot protection off (warned in production).
TURNSTILE_SECRET_KEY=

# Market data providers (filled in Phase 2)
MARKET_DATA_PROVIDER=yfinance
POLYGON_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
